{
  "name": "attendance-bridge",
  "version": "1.1.0",
  "description": "Desktop app to connect attendance devices by IP and port, sync punches, and backup data",
  "main": "electron-main.js",
  "author": "Attendance Bridge",
  "scripts": {
    "setup": "node setup.js",
    "start": "electron .",
    "server": "node server/index.js",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "mysql": "^2.18.1",
    "node-zklib": "^1.3.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.attendance.bridge",
    "productName": "Attendance Bridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "server/**/*",
      "renderer/**/*",
      "asset/**/*",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "icon": "asset/mPairLogo.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "asset/mPairLogo.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "mac": {
      "icon": "asset/mPairLogo.png",
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
